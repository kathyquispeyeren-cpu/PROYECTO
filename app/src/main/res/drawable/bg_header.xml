<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#0B1624"
                android:startColor="#16304C" />
        </shape>
    </item>
    <item
        android:gravity="bottom"
        android:height="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#2E7DD1" />
        </shape>
    </item>
</layer-list>
