<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0.1"
        android:text="@string/dialog_nueva"
        android:textColor="@color/fap_blue_light"
        android:textSize="16sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="@color/military_line" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:letterSpacing="0.08"
        android:text="@string/label_asunto"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input"
        android:hint="@string/hint_asunto"
        android:inputType="textCapSentences"
        android:maxLines="1"
        android:padding="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="#7E8870"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:letterSpacing="0.08"
        android:text="@string/label_detalle"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input"
        android:gravity="top"
        android:hint="@string/hint_detalle"
        android:inputType="textCapSentences|textMultiLine"
        android:minLines="4"
        android:padding="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="#7E8870"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:letterSpacing="0.08"
        android:text="@string/label_prioridad"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgPriority"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rbImportante"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:buttonTint="@color/priority_high"
            android:gravity="center_vertical"
            android:text="@string/prioridad_importante"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rbMedia"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:buttonTint="@color/priority_medium"
            android:gravity="center_vertical"
            android:text="@string/prioridad_media"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rbBaja"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:buttonTint="@color/priority_low"
            android:gravity="center_vertical"
            android:text="@string/prioridad_baja"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rbAcademico"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:buttonTint="@color/priority_academic"
            android:gravity="center_vertical"
            android:text="@string/prioridad_academico"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="end"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:background="@drawable/bg_button_outline"
            android:letterSpacing="0.06"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/cancelar"
            android:textColor="@color/fap_blue_light"
            android:textSize="12sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_button_primary"
            android:letterSpacing="0.06"
            android:minWidth="0dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/guardar"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
